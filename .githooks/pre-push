#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
node scripts/feature-ledger.mjs check
if ! git diff HEAD --quiet -- src public package.json package-lock.json index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json docs/feature-ledger.json docs/FEATURE_LEDGER.md docs/feature-ledger-baseline.json; then
  echo '推送前请先将已核对的源码和功能台账一并提交，工作区仍有未提交差异。' >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  node scripts/feature-ledger.mjs check --ref "$local_oid"
done
